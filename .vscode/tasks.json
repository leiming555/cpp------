{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe 编译所有cpp",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${workspaceFolder}\\app.exe",
                "${workspaceFolder}\\*.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译整个项目"
        }
    ],
    "version": "2.0.0"
}
